AUTH_URL=
API_URL=
PRIVATE_KEY=
PUBLIC_KEY=
XRPL_WSS_URL=

# Comma-separated ledger IDs offered in every ledger picker.
# Leave empty to fall back to the built-in list (same as below).
XRPL_LEDGER_IDS=xrpl-testnet-august-2024,xrpl-devnet,xrpl-custody-devnet,xrpl

# Ledger preselected in the filters and forms across the app.
# If it isn't in XRPL_LEDGER_IDS it gets prepended to the list.
# Leave empty to use the first entry of XRPL_LEDGER_IDS.
DEFAULT_LEDGER_ID=xrpl-testnet-august-2024
